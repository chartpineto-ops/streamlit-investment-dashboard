# Local identity fallback. Hosted requests use the authenticated Sites user header.
INTELBRIDGE_DEMO_USER_EMAIL=alex.parker@intelbridge.demo
AI_PROVIDER=mock

# Optional live provider. Keep keys server-side and configure production values
# through Sites environment variables, never in source control.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_MS=20000
